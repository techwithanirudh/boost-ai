{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "compile": "bun build --compile --minify --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --env-file ../../.env --hot src/index.ts",
    "start": "bun run --env-file ../../.env dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.37",
    "@boost/db": "workspace:*",
    "@boost/env": "workspace:*",
    "@boost/validators": "workspace:*",
    "ai": "^6.0.105",
    "ai-retry": "^1.2.0",
    "ai-sdk-openai-websocket-fetch": "^1.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.2",
    "ioredis": "^5.10.0",
    "ky": "^1.7.5",
    "pino": "^10.3.1",
    "resumable-stream": "^2.2.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boost/config": "workspace:*",
    "@types/bun": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
