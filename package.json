{
  "name": "boost",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @boost/db db:push",
    "db:studio": "turbo -F @boost/db db:studio",
    "db:generate": "turbo -F @boost/db db:generate",
    "db:migrate": "turbo -F @boost/db db:migrate",
    "check": "ultracite check .",
    "check:unsafe": "ultracite fix --unsafe true .",
    "check:write": "ultracite fix ."
  },
  "dependencies": {
    "@boost/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@boost/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.2.4",
    "@biomejs/biome": "2.4.0"
  },
  "packageManager": "bun@1.3.10"
}
