{
  "name": "@ev3/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema.ts"
    },
    "./queries": {
      "default": "./src/queries/index.ts"
    },
    "./queries/*": {
      "default": "./src/queries/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ev3/env": "workspace:*",
    "@ev3/validators": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "ai": "^6.0.105",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ev3/config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}
