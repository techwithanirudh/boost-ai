# ── Server ────────────────────────────────────────────────────────────────────

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# OpenAI API key (required)
OPENAI_API_KEY=

# CORS origin for the web UI
CORS_ORIGIN=http://localhost:3001

# Hub FastAPI base URL
HUB_BASE_URL=http://localhost:8000

# Per-request HTTP timeout for hub calls (ms)
STEP_TIMEOUT_MS=15000

# HuggingFace API token for Depth Pro depth estimation (optional — depth skipped if unset)
HF_API_TOKEN=

# Redis URL for resumable stream persistence (optional but required for resume)
REDIS_URL=

# ── Hub ───────────────────────────────────────────────────────────────────────

# Bluetooth MAC of the LEGO Mindstorms EV3 brick
# Find with: bluetoothctl devices  (looks like 00:16:53:XX:XX:XX)
HUB_MAC=00:16:53:61:1F:7E

# ── Web ───────────────────────────────────────────────────────────────────────

# Server URL reachable from the browser
VITE_API_URL=http://localhost:3000
