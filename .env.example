# ── Server (apps/server) ──────────────────────────────────────────────────────

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Google Gemini API key (required) — get one at https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# CORS origin for the web UI
CORS_ORIGIN=http://localhost:3001

# Hub FastAPI base URL (auto-resolved in docker compose)
HUB_BASE_URL=http://localhost:8000

# MediaMTX HTTP API base URL (e.g. http://mediamtx:8888 in compose)
MEDIAMTX_BASE_URL=http://localhost:8888

# RTSP stream path published by the camera (iPhone Larix default)
MEDIAMTX_STREAM_PATH=cam

# Per-step tool call timeout in ms (default 15s)
STEP_TIMEOUT_MS=15000

# ── Hub (apps/hub) ────────────────────────────────────────────────────────────

# Bluetooth MAC address of the LEGO Boost Move Hub
# Leave empty to use auto-discovery (slower)
HUB_MAC=

# How long to wait for a BLE connection before giving up (seconds)
HUB_CONNECT_TIMEOUT_S=300

# Watchdog: stop motors if no command received within this window (seconds)
WATCHDOG_TIMEOUT_S=5

# Default motor speed [0.0 – 1.0]
MOTOR_DEFAULT_SPEED=0.5

# Max time a single motion command may run (seconds)
COMMAND_TIMEOUT_S=10

# ── Web (apps/web) ────────────────────────────────────────────────────────────

# API base URL — must be reachable from the browser
VITE_API_URL=http://localhost:3000
