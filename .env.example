# ── Server ────────────────────────────────────────────────────────────────────

# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Google Gemini API key (required) — https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# CORS origin for the web UI
CORS_ORIGIN=http://localhost:3001

# Hub FastAPI base URL
HUB_BASE_URL=http://localhost:8000

# Per-request HTTP timeout for hub calls (ms)
STEP_TIMEOUT_MS=15000

# MediaMTX HTTP API base URL
MEDIAMTX_BASE_URL=http://localhost:8888

# RTSP stream path (iPhone Larix publishes to rtsp://<host>:8554/cam by default)
MEDIAMTX_STREAM_PATH=live/stream

# ── Hub ───────────────────────────────────────────────────────────────────────

# Bluetooth MAC of the LEGO Boost Move Hub (leave empty for auto-discovery)
HUB_MAC=

# ── Web ───────────────────────────────────────────────────────────────────────

# Server URL reachable from the browser
VITE_API_URL=http://localhost:3000
